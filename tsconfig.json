{
  // The formatting of this file is Next.js's own, not Prettier's: every array
  // element on its own line. `next dev` maintains this file and rewrites all of
  // it whenever it changes one thing, so matching its serializer is what keeps a
  // dev server from leaving an uncommitted whole-file reformat behind. Prettier
  // is told to skip it in .prettierignore, and
  // tests/unit/toolchain/tsconfig-shape.test.ts holds both halves.
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // scripts/seed-event.ts is run directly by Node, which strips types and needs
    // the extension to resolve. It reaches one leaf module in src/ so that the
    // default RSVP question set has one definition and not two.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "*.config.ts",
    "*.config.mts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
