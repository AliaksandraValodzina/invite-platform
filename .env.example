# Copy to .env.local, which is git ignored, and fill in from your own stack.
# Nothing in this file is a secret and nothing in it names a hosted project.
#
# For a local stack: `supabase start`, then `supabase status` prints the API URL
# and the service role key for it. Those keys are the CLI's well known local
# ones and are not worth protecting; a hosted project's are, and belong only in
# the deployment's environment settings.

# Where the database API lives. No trailing path.
SUPABASE_URL=http://127.0.0.1:54321

# Read by src/lib/supabase/service.ts, which is server only. This value must
# never appear in a NEXT_PUBLIC_ variable, in this repo, or in a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin used for canonical and Open Graph URLs. Optional: absent, the
# app falls back to http://localhost:3000 (src/lib/env.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
