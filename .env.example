# Copy to .env.local, which is git ignored, and fill in from your own stack.
# Nothing in this file is a secret and nothing in it names a hosted project.
#
# For a local stack: `supabase start`, then `supabase status` prints the API URL
# and the service role key for it. Those keys are the CLI's well known local
# ones and are not worth protecting; a hosted project's are, and belong only in
# the deployment's environment settings.

# Where the database API lives. No trailing path.
SUPABASE_URL=http://127.0.0.1:54321

# Read by src/lib/supabase/service.ts, which is server only. This value must
# never appear in a NEXT_PUBLIC_ variable, in this repo, or in a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# The publishable key. Read by src/lib/auth/config.ts, which signs a buyer in
# and reads their dashboard as them. It grants nothing on its own: every table
# revokes `anon` at three layers, so a request carrying only this key can read
# nothing at all. That is why the sign-in path uses it rather than the service
# role key.
SUPABASE_ANON_KEY=

# Absolute origin used for canonical and Open Graph URLs, for the callback a
# magic link returns to, and for the claim links `scripts/issue-codes.ts` prints
# into an Etsy order message. Optional: absent, the app falls back to
# http://localhost:3000 (src/lib/env.ts) and the script says so in its output.
#
# The product is Mirthly and production is https://mirthly.app, but no host is
# hardcoded anywhere in the repo and this file keeps the local value: a checkout
# that silently pointed a dev server's links at production would be worse than
# one that pointed them nowhere. The deployment's auth settings need a redirect
# entry that admits `<origin>/auth/callback` WITH its query string, or a claim
# will be silently dropped on the way back from a mailbox. See
# docs/activation.md, docs/hosting.md, and the local entry in
# supabase/config.toml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Named in the privacy statement as where the database lives, and read from the
# environment rather than committed: AGENTS.md forbids a hosted region appearing
# in this repo, because the region is chosen once, is effectively irreversible,
# and is the captain's call. Absent, the page says so rather than inventing one.
# A country or a plain-English place, not a provider region code.
NEXT_PUBLIC_DATA_REGION=

# The address a guest or a buyer writes to about their data. Absent, the privacy
# statement says it is not configured yet, which is the honest answer before a
# domain exists and is better than an address nobody reads.
NEXT_PUBLIC_PRIVACY_CONTACT=

# Uploads ---------------------------------------------------------------------
#
# Nothing below is needed to run or test this locally. With no R2 variables set,
# uploads go to a directory this repo ignores and are served by the app itself
# at /a/<key>, with the same headers a CDN would send. See docs/uploads.md.
#
# A DEPLOYMENT is the exception: a serverless function's disk is read only and
# does not outlive the request, so a deployment with none of these set has no
# object store at all and refuses an upload rather than pretending. See
# docs/hosting.md.

# The hostname assets are served from. A hostname the PLATFORM owns, pointed at
# the bucket by DNS, so that changing storage provider is a DNS change and not a
# rewrite of every stored asset URL. A storage vendor's own hostname is refused:
# no buyer's asset URL is ever a Cloudflare address (decision, captain,
# 2026-08-20). Absent, assets are served from this app.
NEXT_PUBLIC_ASSET_HOST=

# Cloudflare R2, over its S3 compatible API. Set all four or none: a half
# configured store fails at the moment a buyer uploads rather than at deploy
# time, and the code refuses it for that reason. These are secrets and belong
# only in the deployment's environment settings.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Forces a driver: memory, filesystem or r2. Absent, R2 is used when its
# variables are present and the local filesystem otherwise.
UPLOADS_DRIVER=

# Where the filesystem driver writes. Absent, .uploads in the repository root.
UPLOADS_LOCAL_ROOT=

# Bearer token required by POST /api/uploads/sweep, which removes bytes the
# retention sweep has already condemned. Absent, that endpoint is open and
# bounded to a small batch; the route explains why that is a considered
# position rather than an oversight.
UPLOADS_SWEEP_SECRET=
